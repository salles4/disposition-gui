# NOTE: The core API IP/port, app port and teller port are set on the admin dashboard
# ("Server Connection" card) and saved to data/config.json (git-ignored, so pulls never touch it).
# The values below are only the starting defaults used until the dashboard has saved its own.

# Backend (Python Flask + Socket.IO Server Configuration)
PORT=5000
HOST=0.0.0.0

# Teller service port (real device payments)
TELLER_PORT=5010

# Frontend (Vite Dev Server Configuration)
VITE_PORT=5100
VITE_HOST=0.0.0.0

# Frontend WebSocket Connection port in dev mode (points to the python backend PORT / app port)
VITE_WS_PORT=5000

# Core/Remote API Server configuration
API_BASE_URL=http://103.93.223.103:9080
# Optional: only used by the Testing view until the server sends the dashboard setting
VITE_API_BASE_URL=http://103.93.223.103:9080
